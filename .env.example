# ========================================================
# ASESOR AUTOMOTRIZ VIRTUAL (LUIS) - CONFIGURATION
# ========================================================

# --- Backend Configuration ---
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Google Gen AI & Google ADK
# Get your free Gemini API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-1.5-pro

# Database Persistence (English Tables and Columns)
DATABASE_PATH=./data/automotive_advisor.db

# OpenTelemetry & Google Cloud Trace
ENABLE_CLOUD_TRACE=false
GCP_PROJECT_ID=your-gcp-project-id

# Conversational Context Limits
MAX_HISTORY_TOKENS=4000
MAX_TURNS_HISTORY=10

# --- Frontend Configuration ---
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
